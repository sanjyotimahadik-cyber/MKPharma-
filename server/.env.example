# Copy to .env and adjust. Without a .env the API uses SQLite at data/dev.sqlite3.
PORT=4000
JWT_SECRET=change-me

# Admin sign-in. Admins cannot self-register: on start the API makes sure this admin exists
# (an existing admin's password is not overwritten). More admins can be added in the database.
ADMIN_EMAIL=admin@mkanimalhealth.com
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Administrator

# sqlite (default), postgres or mysql
DB_CLIENT=sqlite
SQLITE_FILE=data/dev.sqlite3

# Used when DB_CLIENT=mysql (create the database first: CREATE DATABASE mk_animal_health;)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mk_animal_health

# Used when DB_CLIENT=postgres (Supabase, Neon, or a local server). For Supabase use the
# Session pooler string from Project -> Connect (works on IPv4 networks).
DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Put the database password in DB_PASSWORD above (no URL encoding needed).
# DB_SSL=false   # only for a local Postgres without TLS
