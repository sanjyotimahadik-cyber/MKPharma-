{
  "name": "mk-animal-health-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for MK Animal Health ERP",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:latest",
    "db:seed": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js seed:run",
    "db:reset": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:rollback --all && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6"
  }
}
